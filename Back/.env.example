# ============================================================
# Helados del Valle — Backend Variables de Entorno (Plantilla)
#
# INSTRUCCIONES:
# Si ejecutas el backend de manera aislada, copia este archivo como .env.local
# o .env dentro de la carpeta Back/.
# ============================================================

# Conexión agrupada (Pooled) para la API
DATABASE_URL=postgresql://tu_usuario:tu_contraseña@ep-ejemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Conexión directa (Unpooled) para migraciones e init-db
DATABASE_URL_UNPOOLED=postgresql://tu_usuario:tu_contraseña@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Puerto del servidor
PORT=3000

