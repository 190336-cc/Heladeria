# ============================================================
# Helados del Valle — Variables de Entorno 
#
# INSTRUCCIONES:
# Copia este archivo como .env.local o .env en la raíz del proyecto.
# ============================================================

# Conexión con PostgreSQL / Neon (Conexión agrupada / Connection Pooling para la API)
DATABASE_URL=postgresql://tu_usuario:tu_contraseña@ep-ejemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Conexión directa con PostgreSQL / Neon (Unpooled — Obligatoria para ejecutar npm run db:init)
DATABASE_URL_UNPOOLED=postgresql://tu_usuario:tu_contraseña@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Puerto del servidor backend Express (por defecto 3000 si se omite)
PORT=3000

